# 1. Environment variables & Secrets (CRITICAL)
# Prevents sensitive API keys (LiveKit, Groq, Deepgram) from being baked into image layers
.env
.env.*
*.pem
*.key

# 2. Local Python Virtual Environments (CRITICAL)
# You are developing on Windows; host Windows binaries and site-packages must not be copied into Linux containers
venv/
.venv/
env/
ENV/

# 3. Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 4. Git Metadata & Repository Files
.git/
.gitignore
.gitattributes

# 5. Local Vector Database (Optional/Legacy)
# Chroma SQLite DB generated by ingest.py; kb/*.json is loaded directly into memory at runtime
rag/chroma_symptoms_db_raw/

# 6. Local Ad-hoc Test & Scratch Files
scratch_test.py
tingting.py
test_cli.py
test_out.txt
eval/

# 7. Logs & Temporary Files
*.log
logs/
*.tmp
temp/

# 8. IDE & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 9. Docker Files
Dockerfile*
docker-compose*.yml
.dockerignore
